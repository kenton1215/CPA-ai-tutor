# ============ CPA 智能备考助手配置示例 ============
# 复制为 .env 后按需填写（.env 不要提交到代码仓库）

# ---------- 对话模型（AI Agent），OpenAI 兼容接口 ----------
# 推荐：阿里云百炼 DashScope 通义千问
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# 或 DeepSeek：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# 或本地 Ollama（无需 API Key；未配置上面的 Key 时自动使用）：
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---------- Embedding / 向量化 ----------
# provider: api（远程）或 local（本地 sentence-transformers，无需 Key）
EMBEDDING_PROVIDER=api
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v1

# 本地向量模型（provider=local 时使用）
# EMBEDDING_MODEL_LOCAL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------- 兼容旧项目变量 ----------
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# ---------- 网络版 / 微信入口 ----------
# 对外访问地址（部署后必填）：登录页会用该地址生成“微信扫一扫”二维码，
# 手机扫码即可打开网页注册/登录学习。本地开发可保持 http://localhost:8501
APP_PUBLIC_URL=

# 微信开放平台（可选，上线后用于真正的微信 OAuth 扫码登录）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# ---------- 开发者权限 ----------
# “知识库与设置”仅对白名单账号开放；逗号分隔手机号/账号。
# 普通学生登录后看不到也打不开该页面。
APP_DEVELOPER_ACCOUNTS=

# ---------- 免费登录次数限额 ----------
# 未注册游客可免费登录 FREE_GUEST_LOGINS 次；注册考生免费 FREE_USER_LOGINS 次。
# 口径：按登录会话计次，同一天重复登录不重复扣。次数用完后锁定学习功能，
# 提示注册或联系管理员（users.paid 字段预留未来付费开通，当前不做支付）。
FREE_GUEST_LOGINS=5
FREE_USER_LOGINS=10

# ---------- 学习闭环 ----------
# 类似题/巩固练习中，同一知识点连续答对多少次后自动标记为已掌握（防蒙对）
WEAK_POINT_MASTERY_STREAK=2
# 组卷时题库缺口的 AI 并行生成线程数（1-8；本地模型建议 1-2）
EXAM_GEN_WORKERS=4
